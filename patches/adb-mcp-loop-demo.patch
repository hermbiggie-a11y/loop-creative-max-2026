diff --git a/uxp/ps/commands/layers.js b/uxp/ps/commands/layers.js
index ca02034..22adb6e 100644
--- a/uxp/ps/commands/layers.js
+++ b/uxp/ps/commands/layers.js
@@ -662,6 +662,8 @@ const createSingleLineTextLayer = async (command) => {
         a.blendMode = getBlendMode(options.blendMode);
         a.name = options.layerName;
         a.opacity = options.opacity;
+        // Loop demo: new text layers inherit the last Character panel settings (e.g. wide tracking) - reset them
+        try { a.textItem.characterStyle.tracking = options.tracking || 0; } catch (e) { }
     });
 };
 
